@{
    Layout = "_Layout";
    ViewData["Title"] = "Información del Restaurante";
}

<div class="min-h-full bg-slate-100 text-slate-900">

    <div class="mx-auto max-w-6xl p-6 lg:p-10">

        <div class="mb-8">

            <p class="text-sm font-semibold text-amber-600">
                Información general
            </p>

            <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900">
                Información del Restaurante
            </h1>

            <p class="mt-2 text-sm text-slate-500">
                Consulta los detalles del establecimiento y sus horarios de atención.
            </p>

        </div>

        <div class="grid gap-6 md:grid-cols-2">

            <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

                <div class="flex items-center gap-4">

                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-xl text-amber-600">
                        ◷
                    </div>

                    <div>

                        <h2 class="text-lg font-black text-slate-900">
                            Horarios de Atención
                        </h2>

                        <p class="mt-1 text-xs text-slate-400">
                            Horario habitual del establecimiento
                        </p>

                    </div>

                </div>

                <div class="mt-6 space-y-3 border-t border-slate-200 pt-5">

                    <div class="flex items-center justify-between gap-4">

                        <span class="text-sm font-medium text-slate-600">
                            Lunes a Viernes
                        </span>

                        <span class="text-sm font-bold text-slate-900">
                            8:00 AM - 9:00 PM
                        </span>

                    </div>

                    <div class="flex items-center justify-between gap-4">

                        <span class="text-sm font-medium text-slate-600">
                            Sábados y Domingos
                        </span>

                        <span class="text-sm font-bold text-slate-900">
                            9:00 AM - 10:00 PM
                        </span>

                    </div>

                </div>

            </section>

            <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

                <div class="flex items-center gap-4">

                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-xl text-amber-600">
                        ☎
                    </div>

                    <div>

                        <h2 class="text-lg font-black text-slate-900">
                            Contacto
                        </h2>

                        <p class="mt-1 text-xs text-slate-400">
                            Información para comunicarse con el restaurante
                        </p>

                    </div>

                </div>

                <div class="mt-6 space-y-4 border-t border-slate-200 pt-5">

                    <div>

                        <p class="text-xs font-bold uppercase tracking-wider text-slate-400">
                            Teléfono
                        </p>

                        <p class="mt-1 text-sm font-semibold text-slate-800">
                            +503 2222-0000
                        </p>

                    </div>

                    <div>

                        <p class="text-xs font-bold uppercase tracking-wider text-slate-400">
                            Dirección
                        </p>

                        <p class="mt-1 text-sm font-semibold text-slate-800">
                            Av. Principal, San Salvador
                        </p>

                    </div>

                </div>

            </section>

        </div>

        <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

            <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">

                <div>

                    <p class="text-xs font-bold uppercase tracking-[0.2em] text-amber-600">
                        RestauranteBD
                    </p>

                    <h2 class="mt-2 text-xl font-black text-slate-900">
                        Atención y servicio
                    </h2>

                    <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
                        Nuestro sistema permite administrar de manera organizada los productos,
                        pedidos, reservas y demás operaciones relacionadas con el restaurante.
                    </p>

                </div>

                <div class="shrink-0 rounded-xl bg-slate-50 px-5 py-4 text-center">

                    <p class="text-xs font-bold uppercase tracking-wider text-slate-400">
                        Estado
                    </p>

                    <p class="mt-1 text-sm font-black text-emerald-600">
                        Establecimiento activo
                    </p>

                </div>

            </div>

        </section>

    </div>

</div>