@{
    ViewData["Title"] = "Inicio";
}

<div class="min-h-full bg-slate-100 text-slate-900">

    <div class="mx-auto max-w-7xl p-6 lg:p-10">

        <div class="mb-8">

            <p class="text-sm font-semibold text-amber-600">
                Panel principal
            </p>

            <div class="mt-2 flex flex-col justify-between gap-4 md:flex-row md:items-end">

                <div>

                    <h1 class="text-3xl font-black tracking-tight text-slate-900">
                        Bienvenido a RestauranteBD
                    </h1>

                    <p class="mt-2 max-w-2xl text-sm text-slate-500">
                        Administra los productos, pedidos, empleados y categorías del restaurante desde un solo lugar.
                    </p>

                </div>

                <a asp-controller="Pedido"
                   asp-action="Index"
                   class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white transition hover:bg-slate-800">
                    Ver pedidos
                </a>

            </div>

        </div>

        <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">

            <div class="rounded-2xl border border-slate-200 bg-white p-6">

                <div class="flex items-center justify-between">

                    <p class="text-sm font-semibold text-slate-500">
                        Pedidos de hoy
                    </p>

                    <span class="rounded-lg bg-amber-50 px-3 py-2 text-sm font-bold text-amber-600">
                        +
                    </span>

                </div>

                <p class="mt-5 text-3xl font-black text-slate-900">
                    24
                </p>

                <p class="mt-1 text-xs text-slate-400">
                    Pedidos registrados
                </p>

            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6">

                <div class="flex items-center justify-between">

                    <p class="text-sm font-semibold text-slate-500">
                        En preparación
                    </p>

                    <span class="rounded-lg bg-amber-50 px-3 py-2 text-sm font-bold text-amber-600">
                        ●
                    </span>

                </div>

                <p class="mt-5 text-3xl font-black text-slate-900">
                    8
                </p>

                <p class="mt-1 text-xs text-slate-400">
                    Pedidos en cocina
                </p>

            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6">

                <div class="flex items-center justify-between">

                    <p class="text-sm font-semibold text-slate-500">
                        Platillos
                    </p>

                    <span class="rounded-lg bg-emerald-50 px-3 py-2 text-sm font-bold text-emerald-600">
                        ✓
                    </span>

                </div>

                <p class="mt-5 text-3xl font-black text-slate-900">
                    32
                </p>

                <p class="mt-1 text-xs text-slate-400">
                    Disponibles en el menú
                </p>

            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6">

                <div class="flex items-center justify-between">

                    <p class="text-sm font-semibold text-slate-500">
                        Estado
                    </p>

                    <span class="rounded-lg bg-emerald-50 px-3 py-2 text-sm font-bold text-emerald-600">
                        ●
                    </span>

                </div>

                <p class="mt-5 text-3xl font-black text-slate-900">
                    Activo
                </p>

                <p class="mt-1 text-xs text-slate-400">
                    Sistema operativo
                </p>

            </div>

        </div>

        <div class="mt-8 grid gap-6 lg:grid-cols-3">

            <div class="rounded-2xl border border-slate-200 bg-white p-6 lg:col-span-2">

                <div>

                    <h2 class="text-lg font-black text-slate-900">
                        Gestión rápida
                    </h2>

                    <p class="mt-1 text-sm text-slate-500">
                        Accede rápidamente a las principales áreas del sistema.
                    </p>

                </div>

                <div class="mt-6 grid gap-4 sm:grid-cols-2">

                    <a asp-controller="Menu"
                       asp-action="Index"
                       class="group rounded-xl border border-slate-200 p-5 transition hover:border-amber-300 hover:bg-amber-50">

                        <div class="flex items-center justify-between">

                            <div>

                                <p class="text-sm font-bold text-slate-900">
                                    Gestionar menú
                                </p>

                                <p class="mt-1 text-xs text-slate-500">
                                    Administra los productos disponibles.
                                </p>

                            </div>

                            <span class="text-xl text-amber-500 transition group-hover:translate-x-1">
                                →
                            </span>

                        </div>

                    </a>

                    <a asp-controller="Pedido"
                       asp-action="Index"
                       class="group rounded-xl border border-slate-200 p-5 transition hover:border-amber-300 hover:bg-amber-50">

                        <div class="flex items-center justify-between">

                            <div>

                                <p class="text-sm font-bold text-slate-900">
                                    Gestionar pedidos
                                </p>

                                <p class="mt-1 text-xs text-slate-500">
                                    Consulta y actualiza los pedidos.
                                </p>

                            </div>

                            <span class="text-xl text-amber-500 transition group-hover:translate-x-1">
                                →
                            </span>

                        </div>

                    </a>

                    <a asp-controller="Empleado"
                       asp-action="Index"
                       class="group rounded-xl border border-slate-200 p-5 transition hover:border-amber-300 hover:bg-amber-50">

                        <div class="flex items-center justify-between">

                            <div>

                                <p class="text-sm font-bold text-slate-900">
                                    Empleados
                                </p>

                                <p class="mt-1 text-xs text-slate-500">
                                    Consulta la información del personal.
                                </p>

                            </div>

                            <span class="text-xl text-amber-500 transition group-hover:translate-x-1">
                                →
                            </span>

                        </div>

                    </a>

                    <a asp-controller="Categoria"
                       asp-action="Index"
                       class="group rounded-xl border border-slate-200 p-5 transition hover:border-amber-300 hover:bg-amber-50">

                        <div class="flex items-center justify-between">

                            <div>

                                <p class="text-sm font-bold text-slate-900">
                                    Categorías
                                </p>

                                <p class="mt-1 text-xs text-slate-500">
                                    Organiza las categorías del menú.
                                </p>

                            </div>

                            <span class="text-xl text-amber-500 transition group-hover:translate-x-1">
                                →
                            </span>

                        </div>

                    </a>

                </div>

            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6">

                <p class="text-xs font-bold uppercase tracking-[0.2em] text-amber-600">
                    RestauranteBD
                </p>

                <h2 class="mt-3 text-xl font-black text-slate-900">
                    Administración del restaurante
                </h2>

                <p class="mt-3 text-sm leading-6 text-slate-500">
                    Utiliza el menú lateral para navegar entre las diferentes áreas de gestión del sistema.
                </p>

                <div class="mt-6 border-t border-slate-200 pt-5">

                    <div class="flex items-center justify-between py-2">

                        <span class="text-sm text-slate-500">
                            Sistema
                        </span>

                        <span class="text-sm font-bold text-emerald-600">
                            Operativo
                        </span>

                    </div>

                    <div class="flex items-center justify-between py-2">

                        <span class="text-sm text-slate-500">
                            Base de datos
                        </span>

                        <span class="text-sm font-bold text-emerald-600">
                            Conectada
                        </span>

                    </div>

                    <div class="flex items-center justify-between py-2">

                        <span class="text-sm text-slate-500">
                            Versión
                        </span>

                        <span class="text-sm font-bold text-slate-700">
                            1.0
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>