@{
    ViewData["Title"] = "Reservar Mesa";
}

<div class="min-h-screen bg-slate-900 text-slate-100 p-6 sm:p-8">
    <div class="max-w-7xl mx-auto space-y-8">
        <!-- Encabezado -->
        <div class="border-b border-slate-800 pb-6">
            <h1 class="text-3xl font-extrabold text-amber-500 tracking-tight">Reservar Mesa</h1>
            <p class="text-sm text-slate-400 mt-1">Selecciona la fecha, hora, número de personas y tu mesa preferida.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <!-- Formulario de Reserva -->
            <div class="lg:col-span-5 bg-slate-800/80 border border-slate-700/60 p-6 rounded-2xl shadow-xl backdrop-blur-sm space-y-5">
                <h2 class="text-xl font-bold text-white mb-4">Datos de la Reservación</h2>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Nombre completo</label>
                    <input type="text" placeholder="Tu nombre completo" class="w-full bg-slate-900 border border-slate-700 text-slate-200 text-sm rounded-lg p-3 focus:ring-2 focus:ring-amber-500 focus:outline-none" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Número de Personas</label>
                        <select class="w-full bg-slate-900 border border-slate-700 text-slate-200 text-sm rounded-lg p-3 focus:ring-2 focus:ring-amber-500 focus:outline-none">
                            <option>1 Persona</option>
                            <option>2 Personas</option>
                            <option>4 Personas</option>
                            <option>6 Personas</option>
                            <option>8+ Personas</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Mesa Seleccionada</label>
                        <input type="text" placeholder="Ej. Mesa 03" class="w-full bg-slate-900 border border-slate-700 text-amber-400 font-bold text-sm rounded-lg p-3 focus:ring-2 focus:ring-amber-500 focus:outline-none" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Fecha</label>
                        <input type="date" class="w-full bg-slate-900 border border-slate-700 text-slate-200 text-sm rounded-lg p-3 focus:ring-2 focus:ring-amber-500 focus:outline-none" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Hora</label>
                        <input type="time" class="w-full bg-slate-900 border border-slate-700 text-slate-200 text-sm rounded-lg p-3 focus:ring-2 focus:ring-amber-500 focus:outline-none" />
                    </div>
                </div>

                <button class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-3.5 rounded-xl transition-all shadow-lg shadow-amber-500/20 text-base mt-4">
                    Confirmar Reservación
                </button>
            </div>

            <!-- Mapa / Estado de Mesas -->
            <div class="lg:col-span-7 bg-slate-800/80 border border-slate-700/60 p-6 rounded-2xl shadow-xl backdrop-blur-sm">
                <h2 class="text-xl font-bold text-white mb-2">Disponibilidad de Mesas</h2>
                <p class="text-xs text-slate-400 mb-6">Haz clic en una mesa para seleccionarla.</p>

                <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                    <!-- Mesa Disponible -->
                    <div class="border-2 border-emerald-500/50 bg-emerald-500/10 p-5 rounded-xl text-center cursor-pointer hover:bg-emerald-500/20 transition-all">
                        <span class="block font-black text-lg text-emerald-400">Mesa 01</span>
                        <span class="text-xs text-slate-300">4 Asientos</span>
                        <span class="block text-[10px] uppercase font-bold text-emerald-400 mt-2">Disponible</span>
                    </div>

                    <!-- Mesa Reservada -->
                    <div class="border-2 border-slate-700 bg-slate-900/50 p-5 rounded-xl text-center opacity-60 cursor-not-allowed">
                        <span class="block font-black text-lg text-slate-400">Mesa 02</span>
                        <span class="text-xs text-slate-500">2 Asientos</span>
                        <span class="block text-[10px] uppercase font-bold text-rose-400 mt-2">Ocupada</span>
                    </div>

                    <!-- Mesa Seleccionada -->
                    <div class="border-2 border-amber-500 bg-amber-500/20 p-5 rounded-xl text-center cursor-pointer ring-2 ring-amber-500">
                        <span class="block font-black text-lg text-amber-400">Mesa 03</span>
                        <span class="text-xs text-slate-200">6 Asientos</span>
                        <span class="block text-[10px] uppercase font-bold text-amber-400 mt-2">Seleccionada</span>
                    </div>

                    <div class="border-2 border-emerald-500/50 bg-emerald-500/10 p-5 rounded-xl text-center cursor-pointer hover:bg-emerald-500/20 transition-all">
                        <span class="block font-black text-lg text-emerald-400">Mesa 04</span>
                        <span class="text-xs text-slate-300">2 Asientos</span>
                        <span class="block text-[10px] uppercase font-bold text-emerald-400 mt-2">Disponible</span>
                    </div>

                    <div class="border-2 border-emerald-500/50 bg-emerald-500/10 p-5 rounded-xl text-center cursor-pointer hover:bg-emerald-500/20 transition-all">
                        <span class="block font-black text-lg text-emerald-400">Mesa 05</span>
                        <span class="text-xs text-slate-300">8 Asientos</span>
                        <span class="block text-[10px] uppercase font-bold text-emerald-400 mt-2">Disponible</span>
                    </div>

                    <div class="border-2 border-slate-700 bg-slate-900/50 p-5 rounded-xl text-center opacity-60 cursor-not-allowed">
                        <span class="block font-black text-lg text-slate-400">Mesa 06</span>
                        <span class="text-xs text-slate-500">4 Asientos</span>
                        <span class="block text-[10px] uppercase font-bold text-rose-400 mt-2">Ocupada</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>