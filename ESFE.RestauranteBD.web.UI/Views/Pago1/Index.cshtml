@{
    ViewData["Title"] = "Procesar Pago";
}

<div class="min-h-screen bg-slate-900 text-slate-100 p-6 sm:p-8">
    <div class="max-w-4xl mx-auto bg-slate-800/80 border border-slate-700/60 rounded-2xl p-8 shadow-2xl space-y-6">
        <div class="border-b border-slate-700 pb-4">
            <h1 class="text-2xl font-extrabold text-amber-500">Módulo de Pago y Facturación</h1>
            <p class="text-xs text-slate-400">Selecciona el método de cobro para finalizar la orden.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Resumen de Cuenta -->
            <div class="bg-slate-900/60 p-5 rounded-xl border border-slate-700 space-y-3">
                <h3 class="font-bold text-white text-lg border-b border-slate-800 pb-2">Resumen #ORD-0104</h3>
                <div class="flex justify-between text-sm text-slate-300"><span>Subtotal:</span> <span>$21.68</span></div>
                <div class="flex justify-between text-sm text-slate-300"><span>Propina (10%):</span> <span>$2.17</span></div>
                <div class="flex justify-between text-sm text-slate-300"><span>IVA (13%):</span> <span>$2.82</span></div>
                <div class="flex justify-between font-extrabold text-lg text-amber-400 border-t border-slate-700 pt-2">
                    <span>Total a Pagar:</span>
                    <span>$26.67</span>
                </div>
            </div>

            <!-- Formulario Metodo Pago -->
            <div class="space-y-4">
                <label class="block text-xs font-semibold text-slate-300">Método de Pago</label>
                <div class="grid grid-cols-3 gap-3">
                    <button class="p-3 bg-amber-500/20 border border-amber-500 text-amber-400 rounded-lg text-xs font-bold text-center">Efectivo</button>
                    <button class="p-3 bg-slate-900 border border-slate-700 text-slate-300 rounded-lg text-xs font-bold text-center hover:border-amber-500">Tarjeta</button>
                    <button class="p-3 bg-slate-900 border border-slate-700 text-slate-300 rounded-lg text-xs font-bold text-center hover:border-amber-500">Transferencia</button>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Efectivo Recibido</label>
                    <input type="text" placeholder="$30.00" class="w-full bg-slate-900 border border-slate-700 text-slate-200 text-sm rounded-lg p-3 focus:ring-2 focus:ring-amber-500 focus:outline-none" />
                </div>

                <div class="p-3 bg-emerald-500/10 border border-emerald-500/30 rounded-lg text-emerald-400 font-bold text-sm flex justify-between">
                    <span>Cambio / Vuelto:</span>
                    <span>$3.33</span>
                </div>

                <button class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-3 rounded-xl transition-all shadow-lg shadow-amber-500/20 mt-2">
                    Completar Cobro e Imprimir Ticket
                </button>
            </div>
        </div>
    </div>
</div>