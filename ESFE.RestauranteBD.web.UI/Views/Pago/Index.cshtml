@* Views/Platillos/Index.cshtml *@
@{
    ViewData["Title"] = "Menú y Platillos";
}

<div class="flex flex-col lg:flex-row gap-6 min-h-[85vh]">

    <!-- Panel Lateral de Pantallas (Sidebar) -->
    <aside class="w-full lg:w-64 bg-slate-900 text-white rounded-2xl p-5 shadow-xl border border-slate-800 flex flex-col justify-between shrink-0">
        <div>
            <div class="flex items-center space-x-2 mb-6 px-2">
                <span class="text-amber-500 font-black text-xl">✦</span>
                <h2 class="text-xs font-bold uppercase tracking-wider text-amber-500">Pantallas</h2>
            </div>

            <nav class="space-y-1.5 text-sm font-medium">
                <a asp-controller="Platillos" asp-action="Index" class="block px-3 py-2.5 rounded-xl bg-amber-500 text-slate-950 font-bold shadow-md shadow-amber-500/10">
                    🍔 Platillos y Menú
                </a>
                <a asp-controller="Postres" asp-action="Index" class="block px-3 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition">
                    🍰 Postres
                </a>
                <a asp-controller="Bebida" asp-action="Index" class="block px-3 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition">
                    🥤 Bebidas
                </a>
                <a asp-controller="Categoria" asp-action="Index" class="block px-3 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition">
                    📁 Categorías
                </a>
                <a asp-controller="Pedido" asp-action="Index" class="block px-3 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition">
                    🛒 Pedidos
                </a>
                <a asp-controller="Empleado" asp-action="Index" class="block px-3 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition">
                    👨‍🍳 Empleados
                </a>
            </nav>
        </div>

        <div class="pt-4 border-t border-slate-800 mt-6">
            <a href="#" class="block w-full text-center bg-rose-500/10 hover:bg-rose-600 text-rose-400 hover:text-white py-2.5 rounded-xl text-sm font-bold transition">
                Salir del Sistema
            </a>
        </div>
    </aside>

    <!-- Área Principal del Menú -->
    <main class="flex-1 bg-slate-900 text-white rounded-2xl p-6 shadow-xl border border-slate-800">

        <!-- Encabezado de la Sección -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 pb-4 border-b border-slate-800">
            <div>
                <h1 class="text-2xl font-black text-amber-500 uppercase tracking-wide">Catálogo de Platillos</h1>
                <p class="text-xs text-gray-400 mt-1">Gestión visual del menú del restaurante</p>
            </div>

            <div class="flex items-center gap-3">
                <a asp-action="Create" class="bg-amber-500 hover:bg-amber-400 text-slate-950 px-4 py-2 rounded-xl text-sm font-bold shadow-lg shadow-amber-500/20 transition flex items-center gap-2">
                    <span>+</span> Nuevo Platillo
                </a>
            </div>
        </div>

        <!-- Barra de Búsqueda y Filtro -->
        <div class="bg-slate-800/60 p-4 rounded-xl border border-slate-700/60 mb-6">
            <form method="get" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <input type="text" placeholder="Buscar por nombre de platillo..." class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-amber-500" />

                <select class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-gray-300 focus:outline-none focus:border-amber-500">
                    <option value="">Todas las Categorías</option>
                    <option value="platillo">Platillos Principales</option>
                    <option value="postre">Postres</option>
                    <option value="bebida">Bebidas</option>
                </select>

                <button type="submit" class="bg-slate-700 hover:bg-slate-600 text-white font-bold py-2 px-4 rounded-lg text-sm transition">
                    Filtrar
                </button>
            </form>
        </div>

        <!-- Grilla de Tarjetas (Catálogo) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">

            <!-- Tarjeta 1: Platillo Principal -->
            <div class="bg-slate-800/80 rounded-2xl overflow-hidden border border-slate-700/80 hover:border-amber-500/50 transition-all duration-300 shadow-lg group">
                <div class="relative h-48 overflow-hidden bg-slate-950">
                    <img src="~/images/hamburguesa-artesanal.jpg" alt="Hamburguesa Artesanal" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.src='https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=600&q=80'" />
                    <span class="absolute top-3 left-3 bg-slate-900/90 text-amber-400 border border-amber-500/30 text-xs px-2.5 py-1 rounded-full font-semibold">
                        Platillo Principal
                    </span>
                    <span class="absolute bottom-3 right-3 bg-amber-500 text-slate-950 font-black text-base px-3 py-1 rounded-xl shadow-md">
                        $8.50
                    </span>
                </div>
                <div class="p-4 flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">Hamburguesa Artesanal</h3>
                        <p class="text-xs text-gray-400 mt-1 line-clamp-2">Carne de res de 200g, queso cheddar derretido, tocino crujiente y cebolla caramelizada en pan brioche.</p>
                    </div>
                    <div class="mt-4 pt-3 border-t border-slate-700/60 flex justify-between items-center text-xs font-semibold">
                        <span class="text-gray-400">ID: <strong class="text-gray-200">PL_01</strong></span>
                        <div class="flex space-x-2">
                            <a href="#" class="px-2.5 py-1.5 bg-blue-500/20 text-blue-400 hover:bg-blue-500 hover:text-white rounded-lg transition">Editar</a>
                            <a href="#" class="px-2.5 py-1.5 bg-rose-500/20 text-rose-400 hover:bg-rose-500 hover:text-white rounded-lg transition">Eliminar</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 2: Bebida -->
            <div class="bg-slate-800/80 rounded-2xl overflow-hidden border border-slate-700/80 hover:border-amber-500/50 transition-all duration-300 shadow-lg group">
                <div class="relative h-48 overflow-hidden bg-slate-950">
                    <img src="~/images/limonada-fresa.jpg" alt="Limonada con Fresa" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.src='https://images.unsplash.com/photo-1513558161293-cdaf765ed2fd?auto=format&fit=crop&w=600&q=80'" />
                    <span class="absolute top-3 left-3 bg-slate-900/90 text-sky-400 border border-sky-500/30 text-xs px-2.5 py-1 rounded-full font-semibold">
                        Bebida Natural
                    </span>
                    <span class="absolute bottom-3 right-3 bg-amber-500 text-slate-950 font-black text-base px-3 py-1 rounded-xl shadow-md">
                        $2.75
                    </span>
                </div>
                <div class="p-4 flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">Limonada de Fresa</h3>
                        <p class="text-xs text-gray-400 mt-1 line-clamp-2">Limonada natural preparada con fresas frescas y hojas de menta servida bien fría.</p>
                    </div>
                    <div class="mt-4 pt-3 border-t border-slate-700/60 flex justify-between items-center text-xs font-semibold">
                        <span class="text-gray-400">ID: <strong class="text-gray-200">BE_01</strong></span>
                        <div class="flex space-x-2">
                            <a href="#" class="px-2.5 py-1.5 bg-blue-500/20 text-blue-400 hover:bg-blue-500 hover:text-white rounded-lg transition">Editar</a>
                            <a href="#" class="px-2.5 py-1.5 bg-rose-500/20 text-rose-400 hover:bg-rose-500 hover:text-white rounded-lg transition">Eliminar</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 3: Postre -->
            <div class="bg-slate-800/80 rounded-2xl overflow-hidden border border-slate-700/80 hover:border-amber-500/50 transition-all duration-300 shadow-lg group">
                <div class="relative h-48 overflow-hidden bg-slate-950">
                    <img src="~/images/cheesecake.jpg" alt="Cheesecake de Frutos Rojos" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.src='https://images.unsplash.com/photo-1533134242443-d4fd215305ad?auto=format&fit=crop&w=600&q=80'" />
                    <span class="absolute top-3 left-3 bg-slate-900/90 text-pink-400 border border-pink-500/30 text-xs px-2.5 py-1 rounded-full font-semibold">
                        Postre
                    </span>
                    <span class="absolute bottom-3 right-3 bg-amber-500 text-slate-950 font-black text-base px-3 py-1 rounded-xl shadow-md">
                        $4.25
                    </span>
                </div>
                <div class="p-4 flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">Cheesecake Frutos Rojos</h3>
                        <p class="text-xs text-gray-400 mt-1 line-clamp-2">Pastel de queso artesanal horneado con base de galleta y cobertura de mermelada de frutos rojos.</p>
                    </div>
                    <div class="mt-4 pt-3 border-t border-slate-700/60 flex justify-between items-center text-xs font-semibold">
                        <span class="text-gray-400">ID: <strong class="text-gray-200">PO_01</strong></span>
                        <div class="flex space-x-2">
                            <a href="#" class="px-2.5 py-1.5 bg-blue-500/20 text-blue-400 hover:bg-blue-500 hover:text-white rounded-lg transition">Editar</a>
                            <a href="#" class="px-2.5 py-1.5 bg-rose-500/20 text-rose-400 hover:bg-rose-500 hover:text-white rounded-lg transition">Eliminar</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </main>
</div>