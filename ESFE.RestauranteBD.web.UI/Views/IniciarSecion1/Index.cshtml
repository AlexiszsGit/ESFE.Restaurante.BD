@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="min-h-screen bg-gray-100 flex items-center justify-center p-6">
    <div class="bg-white p-8 rounded-lg shadow-sm border border-gray-200 w-full max-w-md">
        <div class="text-center mb-6">
            <img src="~/images/logo.png" alt="Logo" class="w-16 h-16 mx-auto rounded-full mb-2" />
            <h1 class="text-2xl font-bold text-gray-800">RestauranteBD</h1>
            <p class="text-sm text-gray-500">Inicia sesión en tu cuenta</p>
        </div>

        <form method="post" action="#">
            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-1">Correo electrónico</label>
                <input type="email" placeholder="usuario@ejemplo.com" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-800 text-sm" />
            </div>
            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-700 mb-1">Contraseña</label>
                <input type="password" placeholder="••••••••" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-800 text-sm" />
            </div>
            <button type="submit" class="w-full bg-gray-900 hover:bg-black text-white font-semibold py-2.5 rounded-md text-sm transition-colors">
                Ingresar
            </button>
        </form>
    </div>
</div>