@{
    ViewData["Title"] = "Privacidad";
}

<div class="min-h-full bg-slate-100 text-slate-900">

    <div class="mx-auto max-w-5xl p-6 lg:p-10">

        <div class="mb-8">

            <p class="text-sm font-semibold text-amber-600">
                Información del sistema
            </p>

            <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900">
                Política de Privacidad
            </h1>

            <p class="mt-2 text-sm text-slate-500">
                Información sobre el manejo y protección de los datos dentro de RestauranteBD.
            </p>

        </div>

        <div class="space-y-6">

            <section class="rounded-2xl border border-slate-200 bg-white p-6 lg:p-8">

                <div class="flex items-start gap-4">

                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-lg text-amber-600">
                        🔒
                    </div>

                    <div>

                        <h2 class="text-lg font-black text-slate-900">
                            Protección de la información
                        </h2>

                        <p class="mt-2 text-sm leading-6 text-slate-500">
                            RestauranteBD está diseñado para gestionar la información necesaria
                            para la administración de un restaurante, procurando mantener los
                            datos organizados y protegidos dentro del sistema.
                        </p>

                    </div>

                </div>

            </section>

            <section class="rounded-2xl border border-slate-200 bg-white p-6 lg:p-8">

                <h2 class="text-lg font-black text-slate-900">
                    Información administrada
                </h2>

                <p class="mt-2 text-sm leading-6 text-slate-500">
                    El sistema puede manejar información relacionada con clientes, empleados,
                    pedidos, platillos, categorías, reservas y pagos, de acuerdo con las
                    funciones disponibles en la aplicación.
                </p>

                <div class="mt-6 grid gap-4 sm:grid-cols-2">

                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">

                        <p class="text-sm font-bold text-slate-800">
                            Datos de clientes
                        </p>

                        <p class="mt-1 text-xs leading-5 text-slate-500">
                            Información necesaria para gestionar clientes y sus pedidos o reservas.
                        </p>

                    </div>

                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">

                        <p class="text-sm font-bold text-slate-800">
                            Información operativa
                        </p>

                        <p class="mt-1 text-xs leading-5 text-slate-500">
                            Datos relacionados con pedidos, productos, empleados y operaciones.
                        </p>

                    </div>

                </div>

            </section>

            <section class="rounded-2xl border border-slate-200 bg-white p-6 lg:p-8">

                <h2 class="text-lg font-black text-slate-900">
                    Uso de la información
                </h2>

                <p class="mt-2 text-sm leading-6 text-slate-500">
                    La información registrada en RestauranteBD se utiliza para facilitar la
                    administración del restaurante, organizar sus operaciones y proporcionar
                    las funcionalidades disponibles dentro del sistema.
                </p>

                <div class="mt-5 space-y-3">

                    <div class="flex items-center gap-3 text-sm text-slate-600">
                        <span class="text-emerald-600">✓</span>
                        Gestión de clientes y empleados
                    </div>

                    <div class="flex items-center gap-3 text-sm text-slate-600">
                        <span class="text-emerald-600">✓</span>
                        Administración de productos y categorías
                    </div>

                    <div class="flex items-center gap-3 text-sm text-slate-600">
                        <span class="text-emerald-600">✓</span>
                        Control y seguimiento de pedidos
                    </div>

                    <div class="flex items-center gap-3 text-sm text-slate-600">
                        <span class="text-emerald-600">✓</span>
                        Gestión de reservas y pagos
                    </div>

                </div>

            </section>

            <section class="rounded-2xl border border-amber-200 bg-amber-50 p-6 lg:p-8">

                <h2 class="text-lg font-black text-slate-900">
                    Importante
                </h2>

                <p class="mt-2 text-sm leading-6 text-slate-600">
                    Esta política forma parte de la documentación del proyecto
                    ESFE.RestauranteBD y puede actualizarse conforme evolucionen las
                    funcionalidades y requerimientos del sistema.
                </p>

            </section>

        </div>

    </div>

</div>