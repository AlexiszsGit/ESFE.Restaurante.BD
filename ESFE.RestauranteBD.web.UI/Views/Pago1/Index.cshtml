@{
    ViewData["Title"] = "Procesar Pago";
}

<div class="min-h-screen bg-slate-100 text-slate-900">

    ```
    <div class="mx-auto max-w-6xl p-6 lg:p-10">

        <div class="mb-8">
            <p class="text-sm font-semibold text-amber-600">
                Facturación
            </p>

            <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900">
                Módulo de Pago y Facturación
            </h1>

            <p class="mt-2 text-sm text-slate-500">
                Selecciona el método de cobro para finalizar la orden.
            </p>
        </div>

        <div class="grid gap-6 lg:grid-cols-5">

            <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">

                <div class="flex items-center justify-between border-b border-slate-200 pb-5">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.2em] text-amber-600">
                            Cuenta
                        </p>

                        <h2 class="mt-1 text-lg font-black text-slate-900">
                            Resumen #ORD-0104
                        </h2>
                    </div>

                    <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-600">
                        Pendiente
                    </span>
                </div>

                <div class="space-y-4 pt-6">

                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500">
                            Subtotal
                        </span>

                        <span class="font-semibold text-slate-800">
                            $21.68
                        </span>
                    </div>

                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500">
                            Propina (10%)
                        </span>

                        <span class="font-semibold text-slate-800">
                            $2.17
                        </span>
                    </div>

                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500">
                            IVA (13%)
                        </span>

                        <span class="font-semibold text-slate-800">
                            $2.82
                        </span>
                    </div>

                    <div class="border-t border-slate-200 pt-5">

                        <div class="flex items-center justify-between">
                            <span class="text-sm font-bold text-slate-700">
                                Total a Pagar
                            </span>

                            <span class="text-2xl font-black text-amber-600">
                                $26.67
                            </span>
                        </div>

                    </div>

                </div>

                <div class="mt-8 rounded-xl bg-slate-50 p-4">

                    <p class="text-xs font-bold uppercase tracking-wider text-slate-400">
                        Estado de la orden
                    </p>

                    <div class="mt-3 flex items-center gap-3">
                        <span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span>

                        <span class="text-sm font-semibold text-slate-700">
                            Pendiente de pago
                        </span>
                    </div>

                </div>

            </section>

            <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-3">

                <div class="mb-6">
                    <h2 class="text-lg font-black text-slate-900">
                        Método de Pago
                    </h2>

                    <p class="mt-1 text-sm text-slate-500">
                        Selecciona cómo realizará el cliente el pago.
                    </p>
                </div>

                <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">

                    <button class="rounded-xl border border-amber-500 bg-amber-50 p-4 text-sm font-bold text-amber-700 transition hover:bg-amber-100">
                        Efectivo
                    </button>

                    <button class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm font-bold text-slate-600 transition hover:border-amber-500 hover:bg-amber-50 hover:text-amber-700">
                        Tarjeta
                    </button>

                    <button class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm font-bold text-slate-600 transition hover:border-amber-500 hover:bg-amber-50 hover:text-amber-700">
                        Transferencia
                    </button>

                </div>

                <div class="mt-6">

                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                        Efectivo Recibido
                    </label>

                    <input type="text"
                           placeholder="$30.00"
                           class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-amber-500 focus:bg-white focus:ring-2 focus:ring-amber-100" />

                </div>

                <div class="mt-5 rounded-xl border border-emerald-200 bg-emerald-50 p-4">

                    <div class="flex items-center justify-between">
                        <span class="text-sm font-semibold text-emerald-700">
                            Cambio / Vuelto
                        </span>

                        <span class="text-lg font-black text-emerald-700">
                            $3.33
                        </span>
                    </div>

                </div>

                <div class="mt-6 border-t border-slate-200 pt-6">

                    <button class="w-full rounded-xl bg-slate-900 px-5 py-3.5 text-sm font-bold text-white transition hover:bg-slate-800">
                        Completar Cobro e Imprimir Ticket
                    </button>

                    <p class="mt-3 text-center text-xs text-slate-400">
                        Verifica el monto antes de completar el cobro.
                    </p>

                </div>

            </section>

        </div>

    </div>
    ```

</div>
