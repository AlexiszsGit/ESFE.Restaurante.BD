@{
    Layout = "_Layout";
    ViewData["Title"] = "Gestión de Pedidos";
}

<div class="p-6 bg-slate-950 min-h-screen text-slate-200">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-bold text-amber-400">Gestión de Pedidos</h1>
            <p class="text-xs text-slate-400">Administra y cambia el estado de los pedidos en curso</p>
        </div>
    </div>

    <div class="bg-slate-900 rounded-xl shadow-lg border border-slate-800 overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
            <thead class="bg-slate-800/60 text-xs uppercase text-slate-400 border-b border-slate-800">
                <tr>
                    <th class="p-3"># Pedido</th>
                    <th class="p-3">Cliente</th>
                    <th class="p-3">Mesa / Entrega</th>
                    <th class="p-3">Total</th>
                    <th class="p-3">Estado</th>
                    <th class="p-3">Acción</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
                <tr class="hover:bg-slate-800/40 transition-colors">
                    <td class="p-3 font-semibold text-white">#001</td>
                    <td class="p-3 text-slate-300">Cliente General</td>
                    <td class="p-3 text-slate-400">Mesa 4</td>
                    <td class="p-3 text-amber-400 font-bold">$18.50</td>
                    <td class="p-3">
                        <span class="bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs px-2 py-0.5 rounded-full font-medium">
                            En Preparación
                        </span>
                    </td>
                    <td class="p-3">
                        <button class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs px-3 py-1 rounded transition-colors">
                            Marcar Listo
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
