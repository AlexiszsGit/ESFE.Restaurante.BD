@{
    ViewData["Title"] = "Pedido / Carrito";
}

<div class="p-6 bg-gray-100 min-h-screen">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Carrito de compras</h1>
        <p class="text-sm text-gray-500">Revisa tus productos antes de confirmar</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Lista de productos -->
        <div class="lg:col-span-2 bg-white p-6 rounded-lg shadow-sm border border-gray-200">
            <h2 class="font-bold text-gray-800 mb-4">Detalle del pedido</h2>

            <div class="divide-y divide-gray-200">
                <div class="py-3 flex justify-between items-center">
                    <div>
                        <h4 class="font-bold text-sm text-gray-800">Hamburguesa x2</h4>
                        <p class="text-xs text-gray-500">$6.50 c/u</p>
                    </div>
                    <span class="font-bold text-sm text-gray-900">$13.00</span>
                </div>
                <div class="py-3 flex justify-between items-center">
                    <div>
                        <h4 class="font-bold text-sm text-gray-800">Limonada x1</h4>
                        <p class="text-xs text-gray-500">$2.00 c/u</p>
                    </div>
                    <span class="font-bold text-sm text-gray-900">$2.00</span>
                </div>
            </div>
        </div>

        <!-- Resumen de Pago -->
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 flex flex-col justify-between h-fit">
            <div>
                <h2 class="font-bold text-gray-800 mb-4">Resumen</h2>
                <div class="space-y-2 text-sm text-gray-600 mb-4">
                    <div class="flex justify-between"><span>Subtotal</span><span>$15.00</span></div>
                    <div class="flex justify-between"><span>IVA (13%)</span><span>$1.95</span></div>
                    <div class="border-t border-gray-200 pt-2 flex justify-between font-bold text-gray-900 text-base">
                        <span>Total</span><span>$16.95</span>
                    </div>
                </div>
            </div>
            <a asp-controller="Pago" asp-action="Index" class="block text-center w-full bg-gray-900 hover:bg-black text-white text-sm font-semibold py-2.5 rounded-md">
                Proceder al pago
            </a>
        </div>
    </div>
</div>