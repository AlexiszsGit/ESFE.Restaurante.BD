<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RestauranteBD</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 flex flex-col min-h-screen font-sans">

    <!-- Navbar Principal con las 12 Vistas -->
    <header class="bg-slate-950 border-b border-slate-800 sticky top-0 z-50 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">

                <!-- Logo -->
                <div class="flex-shrink-0 flex items-center">
                    <a asp-controller="MenuDigital1" asp-action="Index" class="text-xl font-black text-amber-500 tracking-wider hover:text-amber-400 transition-colors">
                        RestauranteBD
                    </a>
                </div>

                <!-- Enlaces de Navegación (Los 12 Módulos) -->
                <nav class="flex flex-wrap items-center gap-2 text-xs font-semibold py-2">
                    <!-- Tus 6 Módulos -->
                    <a asp-controller="PedidoyCarrito1" asp-action="Index" class="px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-amber-400 hover:bg-slate-800 transition-colors">Carrito</a>
                    <a asp-controller="PantallaDeCocina1" asp-action="Index" class="px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-amber-400 hover:bg-slate-800 transition-colors">Cocina</a>
                    <a asp-controller="PedidoListo1" asp-action="Index" class="px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-amber-400 hover:bg-slate-800 transition-colors">Pedido Listo</a>
                    <a asp-controller="Pago1" asp-action="Index" class="px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-amber-400 hover:bg-slate-800 transition-colors">Pago</a>
                    <a asp-controller="ReservarMesas1" asp-action="Index" class="px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-amber-400 hover:bg-slate-800 transition-colors">Reservas</a>
                    <a asp-controller="Reportes1" asp-action="Index" class="px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-amber-400 hover:bg-slate-800 transition-colors">Reportes</a>

                    <div class="h-4 w-px bg-slate-700 mx-1"></div>

                    <!-- Los 6 Módulos de tu compañero -->
                    <a asp-controller="MenuDigital1" asp-action="Index" class="px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-amber-400 hover:bg-slate-800 transition-colors">Menú Digital</a>
                    <a asp-controller="GestionDePedidos1" asp-action="Index" class="px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-amber-400 hover:bg-slate-800 transition-colors">Gestión Pedidos</a>
                    <a asp-controller="GestionDeMenu1" asp-action="Index" class="px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-amber-400 hover:bg-slate-800 transition-colors">Gestión Menú</a>
                    <a asp-controller="Informacion1" asp-action="Index" class="px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-amber-400 hover:bg-slate-800 transition-colors">Información</a>
                    <a asp-controller="CalificarServicio1" asp-action="Index" class="px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-amber-400 hover:bg-slate-800 transition-colors">Calificar</a>
                    <a asp-controller="IniciarSesion1" asp-action="Index" class="px-2.5 py-1.5 rounded-lg text-amber-400 bg-amber-500/10 hover:bg-amber-500/20 transition-colors">Login</a>
                </nav>

            </div>
        </div>
    </header>

    <!-- Contenido Dinámico de cada Vista -->
    <main role="main" class="flex-grow">
        @RenderBody()
    </main>

    <!-- Pie de página -->
    <footer class="bg-slate-950 border-t border-slate-800 py-4 text-center text-xs text-slate-500">
        <div class="max-w-7xl mx-auto px-4">
            &copy; 2026 - RestauranteBD - Todos los derechos reservados.
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>