@{
    ViewData["Title"] = "Calificar servicio";
}

<div class="p-6 bg-gray-100 min-h-screen flex items-center justify-center">
    <div class="bg-white p-8 rounded-lg shadow-sm border border-gray-200 text-center max-w-md w-full">
        <h1 class="text-2xl font-bold text-gray-800 mb-2">¿Cómo fue tu experiencia?</h1>
        <p class="text-sm text-gray-500 mb-6">Tu opinión nos ayuda a mejorar</p>

        <div class="flex justify-center space-x-2 text-3xl mb-6 cursor-pointer text-amber-400">
            ★ ★ ★ ★ ★
        </div>

        <textarea placeholder="Deja un comentario opcional..." class="w-full p-3 border border-gray-300 rounded-md text-sm mb-4 h-24 focus:outline-none"></textarea>

        <button class="w-full bg-gray-900 hover:bg-black text-white text-sm font-semibold py-2.5 rounded-md">
            Enviar calificación
        </button>
    </div>
</div>