<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RestauranteBD</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-100 text-slate-900 min-h-screen font-sans">

    <div class="min-h-screen flex">

        <aside class="w-64 bg-white border-r border-slate-200 fixed left-0 top-0 bottom-0 z-50 flex flex-col">

            <div class="h-20 px-6 flex items-center border-b border-slate-200">
                <a asp-controller="MenuDigital1" asp-action="Index" class="flex items-center gap-3 group">
                    <div class="w-10 h-10 rounded-xl bg-amber-500 flex items-center justify-center text-slate-950 font-black text-lg shadow-sm">
                        R
                    </div>

                    <div>
                        <div class="text-lg font-black tracking-tight text-slate-900 group-hover:text-amber-600 transition">
                            RestauranteBD
                        </div>
                        <div class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">
                            Sistema de gestión
                        </div>
                    </div>
                </a>
            </div>

            <div class="flex-1 overflow-y-auto px-4 py-5">

                <div class="mb-6">
                    <p class="px-3 mb-2 text-[10px] uppercase tracking-widest font-bold text-slate-400">
                        Principal
                    </p>

                    <nav class="space-y-1">

                        <a asp-controller="Home" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
                            <span class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500">
                                ⌂
                            </span>
                            Inicio
                        </a>

                        <a asp-controller="MenuDigital1" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-amber-50 hover:text-amber-700 transition">
                            <span class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center text-amber-600">
                                ≡
                            </span>
                            Menú
                        </a>

                        <a asp-controller="MenuDigital1" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-amber-50 hover:text-amber-700 transition">
                            <span class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center text-amber-600">
                                ◈
                            </span>
                            Menú Digital
                        </a>

                    </nav>
                </div>

                <div class="mb-6">
                    <p class="px-3 mb-2 text-[10px] uppercase tracking-widest font-bold text-slate-400">
                        Pedidos
                    </p>

                    <nav class="space-y-1">

                        <a asp-controller="PedidoyCarrito1" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
                            <span class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500">
                                🛒
                            </span>
                            Carrito
                        </a>

                        <a asp-controller="GestionDePedidos1" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
                            <span class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500">
                                ▤
                            </span>
                            Gestión de Pedidos
                        </a>

                        <a asp-controller="PantallaDeCocina1" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
                            <span class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500">
                                ◉
                            </span>
                            Cocina
                        </a>

                        <a asp-controller="PedidoListo1" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
                            <span class="w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-600">
                                ✓
                            </span>
                            Pedidos Listos
                        </a>

                    </nav>
                </div>

                <div class="mb-6">
                    <p class="px-3 mb-2 text-[10px] uppercase tracking-widest font-bold text-slate-400">
                        Administración
                    </p>

                    <nav class="space-y-1">

                        <a asp-controller="GestionDeMenu1" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
                            <span class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500">
                                ▦
                            </span>
                            Gestión de Menú
                        </a>

                        <a asp-controller="ReservarMesas1" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
                            <span class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500">
                                ◫
                            </span>
                            Reservas
                        </a>

                        <a asp-controller="Pago1" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
                            <span class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500">
                                $
                            </span>
                            Pagos
                        </a>

                        <a asp-controller="Reportes1" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
                            <span class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500">
                                ▥
                            </span>
                            Reportes
                        </a>

                    </nav>
                </div>

                <div class="mb-6">
                    <p class="px-3 mb-2 text-[10px] uppercase tracking-widest font-bold text-slate-400">
                        Sistema
                    </p>

                    <nav class="space-y-1">

                        <a asp-controller="Informacion1" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
                            <span class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500">
                                i
                            </span>
                            Información
                        </a>

                        <a asp-controller="CalificarServicio1" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
                            <span class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500">
                                ★
                            </span>
                            Calificar servicio
                        </a>

                    </nav>
                </div>

            </div>

            <div class="p-4 border-t border-slate-200">

                <a asp-controller="IniciarSesion1" asp-action="Index"
                   class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 hover:bg-amber-50 transition group">

                    <div class="w-9 h-9 rounded-lg bg-slate-900 flex items-center justify-center text-amber-400 font-bold">
                        R
                    </div>

                    <div class="flex-1 min-w-0">
                        <div class="text-xs font-bold text-slate-800">
                            RestauranteBD
                        </div>
                        <div class="text-[10px] text-slate-400">
                            Iniciar sesión
                        </div>
                    </div>

                    <span class="text-slate-400 group-hover:text-amber-600 transition">
                        →
                    </span>

                </a>

            </div>

        </aside>

        <div class="ml-64 min-h-screen flex-1 flex flex-col">

            <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-8 sticky top-0 z-40">

                <div>
                    <p class="text-xs text-slate-400 font-medium">
                        RestauranteBD
                    </p>
                    <h1 class="text-lg font-bold text-slate-900">
                        @ViewData["Title"]
                    </h1>
                </div>

                <div class="flex items-center gap-3">

                    <div class="hidden sm:block text-right">
                        <p class="text-xs font-semibold text-slate-700">
                            Sistema Restaurante
                        </p>
                        <p class="text-[10px] text-slate-400">
                            Panel de administración
                        </p>
                    </div>

                    <div class="w-9 h-9 rounded-full bg-amber-500 flex items-center justify-center text-slate-950 font-black">
                        R
                    </div>

                </div>

            </header>

            <main role="main" class="flex-1 p-6 lg:p-8">
                @RenderBody()
            </main>

            <footer class="bg-white border-t border-slate-200 py-4 px-8">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-400">
                    <span>
                        &copy; 2026 - RestauranteBD
                    </span>

                    <span>
                        Todos los derechos reservados.
                    </span>
                </div>
            </footer>

        </div>

    </div>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>