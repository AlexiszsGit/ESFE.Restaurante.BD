@{
    Layout = "_Layout";
    ViewData["Title"] = "Gestión de Pedidos";
}

<div class="min-h-full bg-slate-100 text-slate-800">

    <div class="w-full px-5 py-7 sm:px-8 lg:px-10 xl:px-12">

        <div class="mb-8 flex flex-col gap-5 xl:flex-row xl:items-center xl:justify-between">

            <div>

                <p class="text-sm font-semibold text-amber-600">
                    ESFE.RestauranteBD
                </p>

                <h1 class="mt-1 text-3xl font-black tracking-tight text-slate-900 lg:text-4xl">
                    Gestión de Pedidos
                </h1>

                <p class="mt-2 text-sm text-slate-500">
                    Administra y cambia el estado de los pedidos en curso.
                </p>

            </div>

            <div class="flex gap-3">

                <button class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-600 shadow-sm transition hover:border-amber-400 hover:text-amber-600">
                    Actualizar
                </button>

                <button class="rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-slate-800">
                    + Nuevo Pedido
                </button>

            </div>

        </div>

        <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                <p class="text-sm text-slate-500">
                    Total Pedidos
                </p>

                <p class="mt-2 text-3xl font-black text-slate-900">
                    24
                </p>

                <p class="mt-1 text-xs text-slate-400">
                    Registrados
                </p>

            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                <p class="text-sm text-slate-500">
                    En Preparación
                </p>

                <p class="mt-2 text-3xl font-black text-slate-900">
                    8
                </p>

                <p class="mt-1 text-xs text-amber-600">
                    Pedidos en proceso
                </p>

            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                <p class="text-sm text-slate-500">
                    Listos
                </p>

                <p class="mt-2 text-3xl font-black text-slate-900">
                    10
                </p>

                <p class="mt-1 text-xs text-emerald-600">
                    Listos para servir
                </p>

            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                <p class="text-sm text-slate-500">
                    Estado
                </p>

                <p class="mt-2 text-lg font-black text-emerald-600">
                    Operativo
                </p>

                <p class="mt-1 text-xs text-slate-400">
                    Gestión activa
                </p>

            </div>

        </div>

        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">

            <div class="flex flex-col gap-4 border-b border-slate-200 p-5 lg:flex-row lg:items-center lg:justify-between">

                <div>

                    <h2 class="text-lg font-black text-slate-900">
                        Pedidos en curso
                    </h2>

                    <p class="mt-1 text-sm text-slate-500">
                        Consulta y actualiza el estado de cada pedido.
                    </p>

                </div>

                <div class="flex flex-col gap-3 sm:flex-row">

                    <input type="text"
                           placeholder="Buscar pedido..."
                           class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-amber-500 focus:bg-white" />

                    <button class="rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white transition hover:bg-slate-800">
                        Buscar
                    </button>

                </div>

            </div>

            <div class="overflow-x-auto">

                <table class="w-full text-left">

                    <thead class="border-b border-slate-200 bg-slate-50">

                        <tr>

                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-400">
                                # Pedido
                            </th>

                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-400">
                                Cliente
                            </th>

                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-400">
                                Mesa / Entrega
                            </th>

                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-400">
                                Total
                            </th>

                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-400">
                                Estado
                            </th>

                            <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-wider text-slate-400">
                                Acción
                            </th>

                        </tr>

                    </thead>

                    <tbody class="divide-y divide-slate-100">

                        <tr class="transition hover:bg-slate-50">

                            <td class="px-6 py-5">

                                <p class="text-sm font-bold text-slate-800">
                                    #001
                                </p>

                            </td>

                            <td class="px-6 py-5">

                                <p class="text-sm font-semibold text-slate-700">
                                    Cliente General
                                </p>

                            </td>

                            <td class="px-6 py-5 text-sm text-slate-500">
                                Mesa 4
                            </td>

                            <td class="px-6 py-5 text-sm font-black text-slate-800">
                                $18.50
                            </td>

                            <td class="px-6 py-5">

                                <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-600">
                                    En Preparación
                                </span>

                            </td>

                            <td class="px-6 py-5">

                                <div class="flex justify-end">

                                    <button class="rounded-lg bg-emerald-600 px-4 py-2 text-xs font-bold text-white transition hover:bg-emerald-700">
                                        Marcar Listo
                                    </button>

                                </div>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

            <div class="flex flex-col gap-3 border-t border-slate-200 p-5 sm:flex-row sm:items-center sm:justify-between">

                <p class="text-xs text-slate-400">
                    Mostrando pedidos registrados en el sistema
                </p>

                <div class="flex gap-2">

                    <button class="rounded-lg border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-400">
                        Anterior
                    </button>

                    <button class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-bold text-white">
                        1
                    </button>

                    <button class="rounded-lg border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-50">
                        2
                    </button>

                    <button class="rounded-lg border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-50">
                        Siguiente
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>